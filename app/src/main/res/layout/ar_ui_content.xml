<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ar_ui_root"
    android:clipChildren="false"
        android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.orb.slam2s.camera.CameraPreviewView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:id="@+id/my_fake_glsurface_view" />

    <com.orb.slam2s.graphics.AspectGLSurfaceView
        android:id="@+id/ar_object_view_gles2_obj"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true" />

    <View
        android:id="@+id/touch_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/info_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:background="@drawable/bg_candy_hud_panel">
        <TextView
            android:id="@+id/text_fps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/hud_fps"
            android:textSize="13sp"
            android:textStyle="bold"
            android:shadowColor="@color/text_shadow"
            android:shadowRadius="6"
            android:shadowDx="0"
            android:shadowDy="2"
            tools:text="30.0 FPS" />
        <TextView
            android:id="@+id/text_map_stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/hud_stats"
            android:textSize="11sp"
            android:layout_marginTop="2dp"
            android:shadowColor="@color/text_shadow"
            android:shadowRadius="6"
            android:shadowDx="0"
            android:shadowDy="2"
            tools:text="KFs: 0 | MPs: 0 | Plane: No" />
    </LinearLayout>

    <com.orb.slam2s.ui.VirtualJoystickView
        android:id="@+id/joystick_view"
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="14dp"
        android:layout_marginBottom="72dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/action_panel"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <FrameLayout
            android:id="@+id/menu_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_candy_menu"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone">
        <LinearLayout
            android:id="@+id/group_ar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:visibility="gone">
            <Button
                android:id="@+id/btn_create_ar_object"
                style="@style/Candy.Row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:tag="row"
                android:text="@string/btn_ar_object" />
            <Button
                android:id="@+id/btn_3dof_cube"
                style="@style/Candy.Row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:tag="row"
                android:text="@string/btn_3dof_on" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/group_map"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:visibility="gone">
            <Button
                android:id="@+id/btn_save_map"
                style="@style/Candy.Row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:tag="row"
                android:text="@string/btn_save" />
            <Button
                android:id="@+id/btn_load_map"
                style="@style/Candy.Row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:tag="row"
                android:text="@string/btn_load" />
            <Button
                android:id="@+id/btn_map_list"
                style="@style/Candy.Row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:tag="row"
                android:text="@string/btn_map" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/group_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:visibility="gone">
            <Button
                android:id="@+id/btn_toggle_camera_preview"
                style="@style/Candy.Row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:tag="row"
                android:text="@string/btn_camera_preview_enabled" />
            <Button
                android:id="@+id/btn_toggle_pointcloud"
                style="@style/Candy.Row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:tag="row"
                android:text="@string/btn_point_cloud" />
            <Button
                android:id="@+id/btn_switch_camera"
                style="@style/Candy.Row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:tag="row"
                android:text="@string/btn_switch_camera" />
            <Button
                android:id="@+id/btn_mirror_vertical"
                style="@style/Candy.Row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:tag="row"
                android:text="@string/btn_mirror_vertical" />
            <Button
                android:id="@+id/btn_mirror_horizontal"
                style="@style/Candy.Row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:tag="row"
                android:text="@string/btn_mirror_horizontal" />
            <Button
                android:id="@+id/btn_reverse_sensor"
                style="@style/Candy.Row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:tag="row"
                android:text="@string/btn_reverse_sensor" />
        </LinearLayout>
        </FrameLayout>

        <com.orb.slam2s.ui.CandyDockLayout
            android:id="@+id/dock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_candy_dock"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="4dp">
        <Button
            android:id="@+id/btn_group_ar"
            style="@style/Candy.Dock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/category_ar" />
        <Button
            android:id="@+id/btn_group_map"
            style="@style/Candy.Dock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/category_map" />
        <Button
            android:id="@+id/btn_group_display"
            style="@style/Candy.Dock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/category_display" />
        </com.orb.slam2s.ui.CandyDockLayout>

    </LinearLayout>

</RelativeLayout>