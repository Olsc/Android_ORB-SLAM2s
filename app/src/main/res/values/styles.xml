<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorPrimary">@android:color/black</item>
        <item name="android:colorPrimaryDark">@android:color/black</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:alertDialogTheme">@style/CandyDialog</item>
    </style>

    <style name="ListTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorPrimary">@android:color/black</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:alertDialogTheme">@style/CandyDialog</item>
    </style>

    <style name="DarkNoActionBarTheme" parent="@style/ListTheme">
        <item name="android:windowBackground">@color/window_background_dark</item>
    </style>

    <style name="CandyDialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_candy_dialog</item>
        <item name="android:windowAnimationStyle">@style/CandyDialogAnim</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:buttonBarButtonStyle">@style/CandyDialogButton</item>
    </style>

    <style name="CandyDialogAnim">
        <item name="android:windowEnterAnimation">@anim/candy_dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/candy_dialog_exit</item>
    </style>

    <style name="CandyDialogButton" parent="@android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:textColor">@color/candy_accent_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Candy.Button" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_candy_btn</item>
        <item name="android:textColor">@color/text_button_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="Candy.Button.Danger">
        <item name="android:background">@drawable/bg_text_button</item>
        <item name="android:textColor">@color/text_danger</item>
    </style>

    <style name="Candy.Dock" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">@color/dock_text</item>
        <item name="android:shadowColor">#99000000</item>
        <item name="android:shadowRadius">3</item>
        <item name="android:shadowDy">1</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="Candy.Row" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/bg_row</item>
        <item name="android:textColor">@color/row_text</item>
        <item name="android:shadowColor">#99000000</item>
        <item name="android:shadowRadius">3</item>
        <item name="android:shadowDy">1</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">176dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
    </style>

    <style name="Candy.IconButton" parent="@android:style/Widget.Material.ImageButton">
        <item name="android:background">@drawable/bg_candy_icon_btn</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>